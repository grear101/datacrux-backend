// Datacrux Smart Sales Platform - Phase 1/2 Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(cuid())
  name          String
  apiKey        String?  @unique // public-facing key for the customer chat widget - not a login credential
  whatsappNumber String? // the business's own WhatsApp number, digits only with country code (e.g. 2348012345678) - where order summaries get sent via wa.me links
  brandingJson  Json     @default("{}")
  aiSettings    Json     @default("{}")
  subscription  String   @default("trial") // trial | active | suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  conversations Conversation[]
  orders        Order[]
  users         AdminUser[]
  auditLogs     AuditLog[]
  customers     Customer[]

  @@map("clients")
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])

  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  minPrice    Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  imageUrl    String?  // hosted photo of the product/service, shown to customers in chat
  isService   Boolean  @default(false) // true = a service (ask for date/time instead of delivery address)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([clientId])
  @@map("products")
}

model Conversation {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  customerId   String?
  status       String   @default("active")
  transcript   Json     @default("[]")
  tokenUsage   Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@index([clientId])
  @@map("conversations")
}

model Order {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  customerName   String?
  customerPhone  String?
  customerEmail  String?
  deliveryAddress String?

  items          OrderItem[]

  subtotal       Decimal  @db.Decimal(10, 2)
  discountTotal  Decimal  @db.Decimal(10, 2) @default(0)
  finalAmount    Decimal  @db.Decimal(10, 2)

  status         String   @default("pending")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  quantity        Int
  listPrice       Decimal  @db.Decimal(10, 2)
  negotiatedPrice Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])

  action     String
  actorType  String
  actorId    String?
  ipAddress  String?
  result     String
  metadata   Json     @default("{}")

  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("audit_logs")
}

model Customer {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  phone        String   // digits only, used to look up returning customers
  name         String?
  orderCount   Int      @default(0)
  lastOrderAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A phone number identifies one customer per business, but the same
  // phone number can belong to different customers across different
  // businesses (tenant isolation) - hence the compound unique constraint
  // instead of a globally unique phone field.
  @@unique([clientId, phone])
  @@index([clientId])
  @@map("customers")
}
