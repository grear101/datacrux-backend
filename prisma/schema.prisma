// Datacrux Smart Sales Platform - Phase 1/2 Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(cuid())
  name          String
  apiKey        String?  @unique
  whatsappNumber String?
  brandingJson  Json     @default("{}")
  aiSettings    Json     @default("{}")
  subscription  String   @default("trial")
  plan          String?
  conversationLimit Int?
  productLimit  Int?
  trialEndsAt   DateTime?
  setupFeePaid  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  conversations Conversation[]
  orders        Order[]
  users         AdminUser[]
  auditLogs     AuditLog[]
  customers     Customer[]
  handoverRequests HandoverRequest[]
  notificationLogs NotificationLog[]

  @@map("clients")
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])

  name        String
  description String?
  specifications String?
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  minPrice    Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  imageUrl    String?
  isService   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([clientId])
  @@map("products")
}

model Conversation {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  customerId   String?
  status       String   @default("active")
  transcript   Json     @default("[]")
  tokenUsage   Int      @default(0)
  messageCount Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@index([clientId])
  @@index([clientId, createdAt])
  @@map("conversations")
}

model Order {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  customerName   String?
  customerPhone  String?
  customerEmail  String?
  deliveryAddress String?
  // The actual structured date/time for a service booking (null for a
  // physical-product order). Kept separate from deliveryAddress so
  // bookings can be queried/sorted properly instead of parsed from text.
  scheduledAt    DateTime?

  items          OrderItem[]

  subtotal       Decimal  @db.Decimal(10, 2)
  discountTotal  Decimal  @db.Decimal(10, 2) @default(0)
  finalAmount    Decimal  @db.Decimal(10, 2)

  status         String   @default("pending")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  quantity        Int
  listPrice       Decimal  @db.Decimal(10, 2)
  negotiatedPrice Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])

  action     String
  actorType  String
  actorId    String?
  ipAddress  String?
  result     String
  metadata   Json     @default("{}")

  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("audit_logs")
}

model Customer {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  phone        String
  name         String?
  orderCount   Int      @default(0)
  lastOrderAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, phone])
  @@index([clientId])
  @@map("customers")
}

model HandoverRequest {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  conversationId String?
  summary        String
  customerName   String?
  customerPhone  String?
  status         String   @default("pending")

  createdAt      DateTime @default(now())

  @@index([clientId])
  @@map("handover_requests")
}

model NotificationLog {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])

  type       String
  periodKey  String

  sentAt     DateTime @default(now())

  @@unique([clientId, type, periodKey])
  @@index([clientId])
  @@map("notification_logs")
}
