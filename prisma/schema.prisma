// Datacrux Smart Sales Platform - Phase 1/2 Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(cuid())
  name          String
  apiKey        String?  @unique // public-facing key for the customer chat widget - not a login credential
  whatsappNumber String? // the business's own WhatsApp number, digits only with country code (e.g. 2348012345678) - where order summaries get sent via wa.me links
  brandingJson  Json     @default("{}")
  aiSettings    Json     @default("{}")
  subscription  String   @default("trial") // trial | active | suspended
  plan          String?  // standard | premium | enterprise (or "internal" for the Datacrux team's own account)
  conversationLimit Int? // max NEW conversations per calendar month; null = unlimited
  productLimit  Int?     // max products this business can have; null = unlimited
  trialEndsAt   DateTime? // a trial only expires if this is set; null = never expires
  setupFeePaid  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  conversations Conversation[]
  orders        Order[]
  users         AdminUser[]
  auditLogs     AuditLog[]
  customers     Customer[]
  handoverRequests HandoverRequest[]
  notificationLogs NotificationLog[]

  @@map("clients")
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])

  name        String
  description String?
  specifications String? // free text: sizes, colors, material, coverage/quantity details (e.g. "1 roll covers 2 square meters") - AMARA references this to answer detailed questions and do quantity calculations
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  minPrice    Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  imageUrl    String?  // hosted photo of the product/service, shown to customers in chat
  isService   Boolean  @default(false) // true = a service (ask for date/time instead of delivery address)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([clientId])
  @@map("products")
}

model Conversation {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  customerId   String?
  status       String   @default("active") // active | completed (order placed) | closed
  transcript   Json     @default("[]")
  tokenUsage   Int      @default(0)
  messageCount Int      @default(0) // customer messages so far, used to cap runaway sessions

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@index([clientId])
  @@index([clientId, createdAt])
  @@map("conversations")
}

model Order {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  customerName   String?
  customerPhone  String?
  customerEmail  String?
  deliveryAddress String?

  items          OrderItem[]

  subtotal       Decimal  @db.Decimal(10, 2)
  discountTotal  Decimal  @db.Decimal(10, 2) @default(0)
  finalAmount    Decimal  @db.Decimal(10, 2)

  status         String   @default("pending")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  quantity        Int
  listPrice       Decimal  @db.Decimal(10, 2)
  negotiatedPrice Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  email        String   @unique
  passwordHash String
  role         String   @default("admin") // owner | admin | superadmin (Datacrux team only)
  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("admin_users")
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])

  action     String
  actorType  String
  actorId    String?
  ipAddress  String?
  result     String
  metadata   Json     @default("{}")

  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("audit_logs")
}

model Customer {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])

  phone        String   // digits only, used to look up returning customers
  name         String?
  orderCount   Int      @default(0)
  lastOrderAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, phone])
  @@index([clientId])
  @@map("customers")
}

model HandoverRequest {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  conversationId String?
  summary        String
  customerName   String?
  customerPhone  String?
  status         String   @default("pending")

  createdAt      DateTime @default(now())

  @@index([clientId])
  @@map("handover_requests")
}

model NotificationLog {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])

  type       String
  periodKey  String

  sentAt     DateTime @default(now())

  @@unique([clientId, type, periodKey])
  @@index([clientId])
  @@map("notification_logs")
}
